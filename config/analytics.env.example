# Copy to a local, untracked .env.analytics file and replace the example token.
# A token authenticates one subject; optional product_ids and basis_ids restrict rows.
BALANCE_ANALYTICS_TOKENS='{"replace-with-random-token":{"subject":"analyst","scopes":["balance:read"]},"replace-with-browser-token":{"subject":"web-analyst","scopes":["balance:read"]}}'
BALANCE_ASSISTANT_TOKEN=replace-with-browser-token
BALANCE_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Used by a local stdio MCP process; HTTP clients send their own Bearer token instead.
BALANCE_ANALYTICS_TOKEN=replace-with-random-token
BALANCE_ANALYTICS_URL=http://127.0.0.1:5001
